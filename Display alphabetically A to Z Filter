 jQuery('.product-cat-filter').click( function(event) {

      // Prevent default action - opening tag page
      if (event.preventDefault) {
          event.preventDefault();
      } else {
          event.returnValue = false;
      }

      // Get tag slug from title attirbute
      var selecetd_taxonomy = $(this).attr('title');
      var selecetd_cat = $(this).attr('href');
     // console.log(selecetd_cat);
      $(".product-cat-filter"). removeClass('current-product-page');
      $(this).addClass('current-product-page');
     // var hash = selecetd_cat.substring(selecetd_cat.indexOf('=')+1);
     // $('.all-box-wrapper').fadeOut();
     $('.load_icon').show();

      data = {
          action: 'filter_posts_cat', // function to execute
          afp_nonce: afp_vars.afp_nonce, // wp_nonce
          taxonomy: selecetd_cat, // selected tag
          //category_id: hash,
  };

      $.post( afp_vars.afp_ajax_url, data, function(response) {

          if( response ) {
              $('.all-box-wrapper').html( response );
              $('.load_icon').hide();
              //$('.all-box-wrapper').fadeIn();
          };
      });
  });

