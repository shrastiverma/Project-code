// AJAX Handler for Filtering Events

function ajax_filter_events() {
    $type = isset($_POST['type']) ? sanitize_text_field($_POST['type']) : 'all';
    $category = isset($_POST['category']) ? sanitize_text_field($_POST['category']) : '';
    $paged = isset($_POST['page']) ? intval($_POST['page']) : 1;

    $today = date("Ymd");
    $meta_query = [];

    if ($type === 'upcoming') {
        $meta_query[] = [
            'key' => 'date',
            'value' => $today,
            'compare' => '>=',
            'type' => 'DATE',
        ];
    } elseif ($type === 'past') {
        $meta_query[] = [
            'key' => 'date',
            'value' => $today,
            'compare' => '<',
            'type' => 'DATE',
        ];
    }

    $args = [
        'post_type' => 'events',
		'post_status'=> 'publish',
        'posts_per_page' => 4 ,
        'paged' => $paged,
        'meta_query' => $meta_query,
        'orderby' => 'meta_value',
        'meta_key' => 'date',
        'order' => 'DESC',
    ];

    if (!empty($category)) {
        $args['tax_query'] = [
            [
                'taxonomy' => 'event-categories',
                'field' => 'slug',
                'terms' => $category,
            ],
        ];
    }

    $query = new WP_Query($args);

    if ($query->have_posts()) {
        echo '<ul class="blog-listing">';
        while ($query->have_posts()) {
            $query->the_post(); ?>
            <li class="mob-100">
                <a href="<?php echo get_permalink(); ?>">
                    <figure><?php echo get_the_post_thumbnail(); ?></figure>
					<div class="cnt-bx">
                    <h3><?php echo get_the_title(); ?></h3>
                    <div class="description"><?php  echo wp_trim_words(get_the_content(), 20, "..."); ?></div>
                    <div class="border-btn">Read More</div>
					</div>
                </a>
            </li>
            <?php
        }
        echo '</ul>';


    // Generate pagination links
?>
      <div class="pagination">
                        <?php
                        echo '<div class="pagination">';
                        echo paginate_links([
                            'base' => esc_url(add_query_arg('paged', '%#%')),
                            'format' => '',
                            'current' => max(1, $paged),
                            'total' => $query->max_num_pages,
                            'prev_text' => __('« Previous'),
                            'next_text' => __('Next »'),
                        ]);
                        echo '</div>';
                        ?>
                    </div>
<?php
  }

    wp_reset_postdata();
    wp_die();
}
add_action('wp_ajax_filter_events', 'ajax_filter_events');
add_action('wp_ajax_nopriv_filter_events', 'ajax_filter_events');

/**Custom Js*/

jQuery(document).ready(function ($) {

    // Handle filter button click
    $('.filter-button').on('click', function (event) {
        event.preventDefault();
        let type = $(this).data('type');
        let category = $(this).data('category');
        let page = 1; // Reset to the first page when a new filter is applied

        $(".filter-button").removeClass('current-event-page');
        $(this).addClass('current-event-page');

        loadEvents(type, category, page);
    });

    $(document).on('click', '.pagination a', function (e) {
    e.preventDefault();
    let page = $(this).data('page') || $(this).attr('href').split('paged=')[1];
    let type = $('.filter-button.current-event-page').data('type') || 'all';
    let category = $('.filter-button.current-event-page').data('category') || '';

    loadEvents(type, category, page);
});
// Function to load events via AJAX
    function loadEvents(type, category, page) {

        $.ajax({
            url: ajaxpagination.ajax_url, // Ensure ajax_url is localized in PHP
            type: 'POST',
            data: {
                action: 'filter_events',
                type: type,
                category: category,
                page: page,
            },
            success: function (response) {
              $('#events-container').html(response);

                updateActiveClass(page);
                window.scrollTo({
                    top: 70,
                    behavior: 'smooth', // For smooth scrolling
                });
           },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
            },
        });
    }

    function updateActiveClass(currentPage) {
        $('.pagination a').removeClass('active'); // Remove active class from all links
        $('.pagination a[data-page="' + currentPage + '"]').addClass('active'); // Add active class to the current page link
    }

});
