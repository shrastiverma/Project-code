/******loadmore.js*****/
jQuery(document).ready(function($) {
    $('.tab').on('click', function() {
        $('.tab').removeClass('active');
        $(this).addClass('active');

        var category = $(this).data('category');

        $('.tab-content').hide();
        if (category === 'all') {
            $('#all-posts').closest('.tab-content').show();
        } else {
            $('.category-posts[data-cat="' + category + '"]').closest('.tab-content').show();
        }
    });
    $(document).on('click', '.load-more', function() {
        var button = $(this);
        var paged = parseInt(button.attr('data-paged')) + 1;
        var catId = button.attr('data-cat');
        var totalPosts = parseInt(button.attr('data-post-count'));
        console.log(totalPosts);

        $.ajax({
            url: load_more_params.ajaxurl,
            type: 'POST',
            data: {
                action: 'load_more',
                paged: paged,
                cat_id: catId
            },
            success: function(response) {
                if ($.trim(response).length > 0) {
                    if (catId) {
                        $('.category-posts[data-cat="' + catId + '"]').append(response);
                    } else {
                        $('#all-posts').append(response);
                    }
                    button.attr('data-post-count', paged);
                }

                // Hide button when no more posts
                if ($.trim(response).length === 0 || paged * 5 >= totalPosts) {
                    button.hide();
                }
            }
        });
    });
});


